# ── Database ─────────────────────────────────────────────────────────────
# Postgres running in Docker. Host port 5432 -> container port 5432.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Real projects use a managed host (Neon/Supabase) behind a pooler; the
# shape of the URL is identical.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bask

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
